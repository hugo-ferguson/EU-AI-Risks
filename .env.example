PDF_PATH=./examples/legislation/eu_ai_act.pdf

NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password

HF_TOKEN=token

# Fast local demo model. If you specifically want Qwen3, use qwen3:4b.
LLM_MODEL=ollama/qwen3:4b
LLM_API_BASE=http://localhost:11434
LLM_TEMPERATURE=0.1
LLM_JSON_NO_THINK=true
LLM_NUM_RETRIES=1
LLM_TIMEOUT=300

# Semantic profile optimisation. This is not keyword matching; it uses
# embedding-based semantic intent profiling, then one final LLM assessment call.
EU_AI_RISKS_PROFILE_MODE=semantic
EU_AI_RISKS_PROFILE_MAX_TOKENS=700
EU_AI_RISKS_TOP_K_PARAGRAPH_CANDIDATES=8
EU_AI_RISKS_TOP_K_PARAGRAPHS=3
EU_AI_RISKS_TOP_K_ARTICLES=3
EU_AI_RISKS_MAX_PARAGRAPHS_PER_ARTICLE=2
EU_AI_RISKS_MAX_CROSS_REFERENCES=2
EU_AI_RISKS_MAX_RELATED_REQUIREMENTS=1
EU_AI_RISKS_RISK_MAX_TOKENS=900
EU_AI_RISKS_WARMUP=true
